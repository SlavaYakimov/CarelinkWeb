{
  "name": "carelink-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:flows": "start-server-and-test \"pnpm start\" http://127.0.0.1:3000/login \"pnpm cypress:run\"",
    "test:e2e:all": "pnpm test:e2e && pnpm test:e2e:flows",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "contracts:generate": "openapi-typescript contracts/auth.openapi.yaml -o src/server/gateway/types.gen.ts",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code src/server/gateway/types.gen.ts",
    "contracts:sync": "node scripts/contracts-sync.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.7.0",
    "lucide-react": "^1.52.0",
    "next": "^15.5.4",
    "pino": "^9.9.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "cypress": "^13.17.0",
    "start-server-and-test": "^2.0.12",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "eslint-plugin-security": "^3.0.1",
    "ioredis-mock": "^8.9.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  }
}
