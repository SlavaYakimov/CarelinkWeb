# Скопируйте в .env.local для разработки. Секреты не коммитить.

APP_ENV=development
APP_ORIGIN=http://localhost:3000

GATEWAY_URL=http://127.0.0.1:8088
GATEWAY_TIMEOUT_MS=10000

REDIS_URL=redis://127.0.0.1:6379

# 32 байта в base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENC_KEY=
# Только при ротации ключа (старый ключ). Не задавайте переменную с пустым значением.
# SESSION_ENC_KEY_PREVIOUS=

SESSION_IDLE_TTL=7d
SESSION_ABSOLUTE_TTL=30d
SESSION_GUEST_TTL=12h
FLOW_TTL=15m

COOKIE_SECURE=false
COOKIE_PREFIX=

TRUSTED_PROXY_HOPS=1
LOG_LEVEL=info

# Синхронизация контракта (pnpm contracts:sync)
# CONTRACTS_SYNC_URL=
# GITHUB_TOKEN=

# E2E / staging (не для prod)
# E2E_SERVICE_TOKEN=
# E2E_COMPOSE_PROJECT=
# CarelinkAuth clone for compose OTP logs (default: ../CarelinkAuth)
# E2E_CARELINK_AUTH_ROOT=/path/to/CarelinkAuth
# Override docker logs command (optional)
# E2E_NOTIFICATION_LOG_CMD=docker compose -f ... logs --tail=800 notification-service
# Compose recovery Cypress (keeper approve via gateway):
# E2E_RECOVERY_KEEPER_WORKSPACE_EMAIL=keeper@workspaces.carelink.app
# E2E_RECOVERY_KEEPER_PASSWORD=
# E2E_RECOVERY_KEEPER_ACCESS_TOKEN=   # optional bypass (family access JWT)
# CYPRESS_RECOVERY_PHONE_DIGITS=      # member phone, digits only
# CYPRESS_RECOVERY_WORKSPACE_EMAIL=   # optional; default yakimovs@workspaces.carelink.app
